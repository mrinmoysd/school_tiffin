{
  "name": "@school-tiffin/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "dev:clear": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --clear",
    "start": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android --all-arch",
    "android:no-bundler": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android --all-arch --no-bundler",
    "ios": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:ios",
    "web": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web",
    "update:development": "cross-env APP_VARIANT=development eas update --channel development",
    "update:development:android": "cross-env APP_VARIANT=development eas update --channel development --platform android",
    "update:development:ios": "cross-env APP_VARIANT=development eas update --channel development --platform ios",
    "update:production": "cross-env APP_VARIANT=production eas update --channel production",
    "update:production:android": "cross-env APP_VARIANT=production eas update --channel production --platform android",
    "update:production:ios": "cross-env APP_VARIANT=production eas update --channel production --platform ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@reduxjs/toolkit": "^2.11.2",
    "@standard-schema/spec": "^1.1.0",
    "@standard-schema/utils": "^0.3.0",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-navigation-bar": "^55.0.9",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "immer": "^11.1.4",
    "react": "19.0.0",
    "react-hook-form": "^7.49.3",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keychain": "^10.0.0",
    "react-native-razorpay": "^2.3.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
